# AIP_SAK Configuration Environment Variables
# Copy this file to .env and insert your real credentials.

# AI Provider: 'gemini' or 'openai' (also supports 'ollama', 'openrouter', 'groq', 'deepseek')
VENICEPT_LLM_PROVIDER=gemini

# Google Gemini API Key (get from: https://aistudio.google.com/app/apikey)
VENICEPT_GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI or OpenAI-Compatible API Key (if using OpenAI / OpenRouter / Groq)
VENICEPT_LLM_API_KEY=your-openai-api-key-here

# API Base URL:
# - Gemini default:  https://generativelanguage.googleapis.com/v1beta/openai
# - OpenAI default:  https://api.openai.com/v1
# - Ollama (local):   http://localhost:11434/v1
# - LM Studio:        http://localhost:1234/v1
# - OpenRouter:       https://openrouter.ai/api/v1
# - Groq:             https://api.groq.com/openai/v1
# - DeepSeek:         https://api.deepseek.com/v1
VENICEPT_LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai

# Default model used by the AI Agent planner and analyst:
# - For Gemini: gemini-1.5-flash or gemini-1.5-pro
# - For OpenAI: gpt-4o or gpt-4o-mini
VENICEPT_DEFAULT_MODEL=gemini-1.5-flash

# Default spending budget per engagement in USD
VENICEPT_DEFAULT_BUDGET_USD=5.0

# Default risk ceiling (0: PASSIVE, 1: SAFE, 2: INTRUSIVE, 3: DESTRUCTIVE)
VENICEPT_DEFAULT_RISK_CEILING=1
