[Unit]
Description=aip_Sak 24/7 Attack Surface Watch Daemon
After=network.target

[Service]
Type=simple
User=venice
WorkingDirectory=/opt/aip_Sak
ExecStart=/usr/local/bin/aip_Sak watch --target 127.0.0.1 --interval 3600
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
